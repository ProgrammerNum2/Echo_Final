# Telegram
TELEGRAM_BOT_TOKEN=
# Backward-compatible alias: BOT_TOKEN=
OWNER_USERNAME=
OWNER_DISPLAY_NAME=Admin
OWNER_LANGUAGE=English

# Provider order = primary first, then fallback.
# Use only providers for which you set a key.
PROVIDERS=gemini,deepl

# Gemini REST API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional DeepL
DEEPL_API_KEY=
DEEPL_API_BASE=https://api-free.deepl.com

# Optional OpenAI-compatible provider (OpenAI, OpenRouter, DeepSeek, local gateway, etc.)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-5-mini

# Runtime
MAX_MESSAGE_CHARS=3500
INVITE_TTL_HOURS=72
SEND_RATE_PER_SEC=20
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SEC=60
LOG_LEVEL=INFO
DB_PATH=/data/bot.db
